@startuml
title Sequence Admin Mengelola Pesanan

skinparam style strictuml
hide footbox

skinparam backgroundColor white
skinparam shadowing false
skinparam handwritten false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor Black

skinparam sequence {
    ParticipantStyle uml2
    LifeLineBorderColor Black
    LifeLineBackgroundColor White
    ParticipantBorderColor Black
    ParticipantBackgroundColor White
    ActorBorderColor Black
    ActorBackgroundColor White
    ArrowColor Black
}

actor "Admin" as Admin
boundary "Halaman Pesanan" as HalamanPesanan
control "OrderController" as OrderController
entity "Order" as Order
entity "Payment" as Payment

Admin -> HalamanPesanan : Buka Halaman Pesanan()
activate HalamanPesanan
HalamanPesanan -> OrderController : Ambil Data Pesanan()
activate OrderController
OrderController -> Order : Cek Data Pesanan()
activate Order
Order --> OrderController : Tampil Data Pesanan()
deactivate Order
OrderController --> HalamanPesanan : Tampil Halaman Pesanan()
deactivate OrderController

Admin -> HalamanPesanan : Klik Detail Pesanan()
HalamanPesanan -> OrderController : Ambil Detail Pesanan()
activate OrderController
OrderController -> Order : Cek Detail()
activate Order
Order --> OrderController : Tampil Detail Pesanan()
deactivate Order
OrderController --> HalamanPesanan : Tampil Detail Pesanan()
deactivate OrderController

Admin -> HalamanPesanan : Ubah Status Pesanan()
HalamanPesanan -> OrderController : Update Status()
activate OrderController
OrderController -> Order : Save Status()
activate Order
Order --> OrderController : Status Tersimpan
deactivate Order
deactivate OrderController

Admin -> HalamanPesanan : Lihat Pembayaran()
HalamanPesanan -> Payment : Cek Data Pembayaran()
activate Payment
Payment --> HalamanPesanan : Tampil Data Pembayaran
deactivate Payment
deactivate HalamanPesanan

@enduml
