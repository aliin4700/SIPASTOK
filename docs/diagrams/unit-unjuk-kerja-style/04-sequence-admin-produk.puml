@startuml
title Sequence Admin Mengelola Produk

skinparam style strictuml
hide footbox

skinparam backgroundColor white
skinparam shadowing false
skinparam handwritten false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor Black

skinparam sequence {
    ParticipantStyle uml2
    LifeLineBorderColor Black
    LifeLineBackgroundColor White
    ParticipantBorderColor Black
    ParticipantBackgroundColor White
    ActorBorderColor Black
    ActorBackgroundColor White
    ArrowColor Black
}

actor "Admin" as Admin
boundary "Form Produk" as FormProduk
control "ProductController" as ProductController
entity "Product" as Product
entity "ProductCategory" as ProductCategory

Admin -> FormProduk : Buka Halaman Produk()
activate FormProduk
FormProduk -> ProductController : Ambil Data Produk()
activate ProductController
ProductController -> Product : Cek Data Produk()
activate Product
Product --> ProductController : Tampil Data Produk()
deactivate Product
ProductController --> FormProduk : Tampil Halaman Produk()
deactivate ProductController

Admin -> FormProduk : Klik Tambah Produk()
Admin -> FormProduk : Input Data Produk
Admin -> FormProduk : Pilih Kategori Produk
FormProduk -> ProductCategory : Cek Kategori()
activate ProductCategory
ProductCategory --> FormProduk : Tampil Kategori()
deactivate ProductCategory

Admin -> FormProduk : Klik Simpan()
FormProduk -> ProductController : Simpan Produk()
activate ProductController
ProductController -> Product : Save()
activate Product
Product --> ProductController : Data Tersimpan
deactivate Product
ProductController --> FormProduk : Tampil Data Produk()
deactivate ProductController

Admin -> FormProduk : Klik Edit()
FormProduk -> ProductController : Update Produk()
activate ProductController
ProductController -> Product : Update()
activate Product
Product --> ProductController : Data Terupdate
deactivate Product
deactivate ProductController

Admin -> FormProduk : Klik Hapus()
FormProduk -> ProductController : Delete Produk()
activate ProductController
ProductController -> Product : Delete()
activate Product
Product --> ProductController : Data Terhapus
deactivate Product
deactivate ProductController
deactivate FormProduk

@enduml
