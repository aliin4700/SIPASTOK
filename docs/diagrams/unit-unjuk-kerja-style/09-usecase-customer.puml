@startuml
title uc Usecase Customer

left to right direction
skinparam shadowing true
skinparam handwritten false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam roundcorner 15
skinparam usecase {
  BackgroundColor #FFF2D8
  BorderColor #B8B8B8
}
skinparam actor {
  BackgroundColor white
  BorderColor #555555
}

actor "Customer" as Customer

rectangle "Use Case Customer Breadlab" {
  usecase "Melakukan Registrasi" as C1
  usecase "Melakukan Login" as C2
  usecase "Melihat Produk" as C3
  usecase "Melihat Detail Produk" as C4
  usecase "Menambahkan Produk ke Keranjang" as C5
  usecase "Melakukan Checkout" as C6
  usecase "Memilih Metode Pengiriman" as C7
  usecase "Melakukan Pembayaran" as C8
  usecase "Melihat Status Pesanan" as C9
  usecase "Melihat Riwayat Pesanan" as C10
}

Customer -- C1
Customer -- C2
Customer -- C3
Customer -- C4
Customer -- C5
Customer -- C6
Customer -- C7
Customer -- C8
Customer -- C9
Customer -- C10
@enduml
