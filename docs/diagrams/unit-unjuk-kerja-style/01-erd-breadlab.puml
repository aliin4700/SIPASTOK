@startuml
title erd ERD Breadlab

skinparam shadowing true
skinparam handwritten false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam ArrowColor #555555
skinparam roundcorner 15

skinparam rectangle {
  BackgroundColor #E6E6E6
  BorderColor #555555
}
skinparam usecase {
  BackgroundColor #FFF2D8
  BorderColor #B8B8B8
}

rectangle "erd ERD Breadlab" as Frame {
  rectangle "Customer" as Customer
  rectangle "Admin" as Admin
  rectangle "Super Admin" as SuperAdmin
  rectangle "Produk" as Produk
  rectangle "Kategori Produk" as Kategori
  rectangle "Keranjang" as Keranjang
  rectangle "Pesanan" as Pesanan
  rectangle "Pembayaran" as Pembayaran
  rectangle "Pengiriman" as Pengiriman

  diamond "membuat" as R1
  diamond "memiliki" as R2
  diamond "memuat" as R3
  diamond "berisi" as R4
  diamond "dibayar" as R5
  diamond "dikirim" as R6
  diamond "berkategori" as R7
  diamond "kelola produk" as R8
  diamond "kelola pesanan" as R9
  diamond "kelola admin" as R10

  ellipse "id_customer" as c1
  ellipse "nama_customer" as c2
  ellipse "email_customer" as c3
  ellipse "hp_customer" as c4

  ellipse "id_admin" as a1
  ellipse "nama_admin" as a2
  ellipse "email_admin" as a3
  ellipse "role" as a4

  ellipse "id_produk" as p1
  ellipse "nama_produk" as p2
  ellipse "harga_produk" as p3
  ellipse "stok_produk" as p4
  ellipse "status_produk" as p5

  ellipse "id_kategori" as k1
  ellipse "nama_kategori" as k2

  ellipse "id_keranjang" as kr1
  ellipse "jumlah_item" as kr2
  ellipse "subtotal" as kr3

  ellipse "id_pesanan" as o1
  ellipse "kode_pesanan" as o2
  ellipse "tanggal_pesanan" as o3
  ellipse "total_bayar" as o4
  ellipse "status_pesanan" as o5

  ellipse "id_pembayaran" as pay1
  ellipse "metode_bayar" as pay2
  ellipse "jumlah_bayar" as pay3
  ellipse "status_bayar" as pay4

  ellipse "id_pengiriman" as s1
  ellipse "metode_pengiriman" as s2
  ellipse "alamat_pengiriman" as s3
  ellipse "status_pengiriman" as s4
}

Customer -- R1
R1 -- Pesanan
Customer -- R2
R2 -- Keranjang
Keranjang -- R3
R3 -- Produk
Pesanan -- R4
R4 -- Produk
Pesanan -- R5
R5 -- Pembayaran
Pesanan -- R6
R6 -- Pengiriman
Produk -- R7
R7 -- Kategori
Admin -- R8
R8 -- Produk
Admin -- R9
R9 -- Pesanan
SuperAdmin -- R10
R10 -- Admin

Customer -- c1
Customer -- c2
Customer -- c3
Customer -- c4
Admin -- a1
Admin -- a2
Admin -- a3
Admin -- a4
Produk -- p1
Produk -- p2
Produk -- p3
Produk -- p4
Produk -- p5
Kategori -- k1
Kategori -- k2
Keranjang -- kr1
Keranjang -- kr2
Keranjang -- kr3
Pesanan -- o1
Pesanan -- o2
Pesanan -- o3
Pesanan -- o4
Pesanan -- o5
Pembayaran -- pay1
Pembayaran -- pay2
Pembayaran -- pay3
Pembayaran -- pay4
Pengiriman -- s1
Pengiriman -- s2
Pengiriman -- s3
Pengiriman -- s4
@enduml
