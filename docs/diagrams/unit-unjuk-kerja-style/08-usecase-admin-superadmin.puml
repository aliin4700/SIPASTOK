@startuml
title Use Case Admin dan Super Admin

skinparam backgroundColor white
skinparam shadowing true
skinparam handwritten false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor #555555
skinparam roundcorner 20
skinparam linetype polyline

skinparam actor {
    BackgroundColor #FFF2D8
    BorderColor #B8B8B8
    FontColor Black
}

skinparam usecase {
    BackgroundColor #FFF2D8
    BorderColor #B8B8B8
    FontColor Black
}

skinparam rectangle {
    BorderColor #999999
    BackgroundColor White
}

top to bottom direction

actor "Super Admin" as SuperAdmin
actor "Admin" as Admin

rectangle "Use Case Admin dan Super Admin Breadlab" as Sistem {
    usecase "Melakukan\nLogin" as UCLogin
    usecase "Mengelola\nHalaman\nDashboard" as UCDashboard
    usecase "Mengelola\nHalaman\nAdmin" as UCAdmin
    usecase "Mengelola\nHalaman\nCustomer" as UCCustomer
    usecase "Mengelola\nHalaman\nProduk" as UCProduk
    usecase "Mengelola\nHalaman\nKategori Produk" as UCKategori
    usecase "Mengelola\nHalaman\nPesanan" as UCPesanan
    usecase "Mengelola\nHalaman\nPembayaran" as UCPembayaran
    usecase "Mengelola\nHalaman\nLaporan" as UCLaporan

    UCLogin -[hidden]down- UCDashboard
    UCDashboard -[hidden]down- UCAdmin
    UCAdmin -[hidden]down- UCCustomer
    UCCustomer -[hidden]down- UCProduk
    UCProduk -[hidden]down- UCKategori
    UCKategori -[hidden]down- UCPesanan
    UCPesanan -[hidden]down- UCPembayaran
    UCPembayaran -[hidden]down- UCLaporan
}

SuperAdmin -- UCLogin
SuperAdmin -- UCDashboard
SuperAdmin -- UCAdmin
SuperAdmin -- UCCustomer
SuperAdmin -- UCProduk
SuperAdmin -- UCKategori
SuperAdmin -- UCPesanan
SuperAdmin -- UCPembayaran
SuperAdmin -- UCLaporan

Admin -- UCLogin
Admin -- UCDashboard
Admin -- UCCustomer
Admin -- UCProduk
Admin -- UCKategori
Admin -- UCPesanan
Admin -- UCPembayaran
Admin -- UCLaporan

@enduml
